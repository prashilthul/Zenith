apiVersion: v1
clusters:
- cluster:
    insecure-skip-tls-verify: true
    server: https://host.docker.internal:61015
  name: kind-atlanclaw
- cluster:
    insecure-skip-tls-verify: true
    server: https://onboarding-tenant.atlan.dev/kubernetes/cluster/loft-cluster
  name: vcluster-platform_loft-cluster
contexts:
- context:
    cluster: kind-atlanclaw
    user: kind-atlanclaw
  name: kind-atlanclaw
- context:
    cluster: vcluster-platform_loft-cluster
    user: vcluster-platform_loft-cluster
  name: vcluster-platform_loft-cluster
current-context: kind-atlanclaw
kind: Config
users:
- name: kind-atlanclaw
  user:
    client-certificate-data: 
    client-key-data: 
- name: vcluster-platform_loft-cluster
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      args:
      - platform
      - token
      - --silent
      - --config
      - /Users/manas.choudhary/.vcluster/config.json
      command: /opt/homebrew/bin/vcluster
      env: null
      interactiveMode: IfAvailable
      provideClusterInfo: false
