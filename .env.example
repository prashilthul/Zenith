# LLM Configuration
LITELLM_API_KEY=sk-your-api-key-here...
LITELLM_MODEL_FAST=anthropic/claude-sonnet-4-20250514
LITELLM_MODEL_REASONING=anthropic/claude-opus-4-20250514
LITELLM_BASE_URL=

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token...
SLACK_SIGNING_SECRET=...
SLACK_CHANNEL_ID=C...
SLACK_APP_TOKEN=xapp-your-app-token...

# Kubernetes
KUBECONFIG=~/.kube/config
NAMESPACE=k8swhisperer-demo

# Blockchain (optional, 25 bonus marks)
STELLAR_SECRET_KEY=S...
STELLAR_CONTRACT_ID=C...
STELLAR_NETWORK=testnet

# Prometheus (optional, bonus marks)
PROMETHEUS_URL=http://localhost:9090

# Feature Flags
ENABLE_PREDICTIVE_ALERTING=true
ENABLE_RUNBOOK_CACHE=true
ENABLE_MULTI_AGENT=true
ENABLE_BLOCKCHAIN=true
